# Optional: get a free key at https://www.football-data.org/client/register.
# It enables live league standings and automatic table-form signals for fixtures.
# Without one, upcoming fixtures automatically come from TheSportsDB's free public feed.
FOOTBALL_DATA_API_KEY=your_api_key_here

# Optional API-Football key for cached match-detail insights.
API_FOOTBALL_KEY=your_api_key_here

# Optional DeepSeek key for cached AI match briefings. Keep this server-side.
DEEPSEEK_API_KEY=your_api_key_here

# Secret used by the scheduled match-insights refresh route.
CRON_SECRET=replace_with_a_long_random_secret

# Site config
NEXT_PUBLIC_SITE_URL=https://bebatips.com
NEXT_PUBLIC_WHATSAPP_NUMBER=254712345678

# AdSense (optional - paste your publisher ID when ready)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
